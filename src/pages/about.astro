---
import Layout from '../layouts/Layout.astro';
const people=[{name:'Jerry Fan',discipline:'Physics and Computer Science',education:'UC Berkeley | Stanford University',image:import.meta.env.PUBLIC_JERRY_PHOTO,linkedin:import.meta.env.PUBLIC_JERRY_LINKEDIN},{name:'Elliot McGuire',discipline:'Materials Science and Engineering',education:'UC Berkeley | UCLA',image:import.meta.env.PUBLIC_ELLIOT_PHOTO,linkedin:import.meta.env.PUBLIC_ELLIOT_LINKEDIN}];
---
<Layout title="About | Northstar Evaluation Firm" page="about"><section class="about section"><h1>About</h1><div class="team-grid">{people.map(person=><article class="person"><div class="portrait">{person.image ? <img src={person.image} alt={person.name}/> : <svg viewBox="0 0 400 400" aria-hidden="true"><circle cx="200" cy="200" r="140"/><circle cx="200" cy="200" r="100"/><path d="M200 20v360M20 200h360M60 60l280 280M340 60 60 340"/><path class="portrait-star" d="m200 105 19 76 76 19-76 19-19 76-19-76-76-19 76-19Z"/></svg>}</div><div class="person-heading"><h2>{person.name}</h2>{person.linkedin && <a href={person.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${person.name} LinkedIn profile`}>↗</a>}</div><p>{person.discipline}</p><p class="education">{person.education}</p>{person.linkedin && <a class="text-link" href={person.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>}</article>)}</div></section></Layout>
