---
import Layout from '../layouts/Layout.astro';
import * as icons from 'simple-icons';
const tools = [['Ansys','siAnsys'],['SOLIDWORKS','siDassaultsystemes'],['Matlab',null],['Onshape',null],['SpaceClaim','siAnsys'],['Unisim',null],['Autodesk fusion','siAutodesk'],['KiCAD','siKicad'],['Simulink',null],['Python','siPython'],['TensorFlow','siTensorflow'],['Pytorch','siPytorch'],['Java',null],['C++','siCplusplus']];
const logoFiles: Record<string, string> = { Matlab: 'matlab.svg', Onshape: 'onshape.svg', Unisim: 'honeywell.svg', Simulink: 'simulink.png', Java: 'java.svg' };
const reasons = ['you need to save time on engineering projects','you want fast, accurate design reviews to speed up implementation timelines','increased modularity of your designs','you need a third party to give you a comprehensive overview of your ideas.'];
const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || '';
---
<Layout>
<section class="hero">
<div class="hero-copy"><h1>No one designs<br/>a bridge <em>alone.</em></h1><p>Engineers are at the forefront of technological innovation in today’s modern landscape. Progress happens when insight meets action.</p><a class="text-link" href="#contact">Start a project <span aria-hidden="true">↗</span></a></div>
<div class="engineering-art" aria-hidden="true"><img src={`${import.meta.env.BASE_URL}golden-bridge-outline.png`} alt="" width="1536" height="1024" fetchpriority="high"/></div>
<div class="hero-bottom"><img class="section-mark" src={`${import.meta.env.BASE_URL}logo.svg`} alt="" width="56" height="56"/><p>Northstar provides third party analysis and design review for engineering and software engineering companies with the help of AI tools and software.</p><a href="#tools" aria-label="Tools we use">↓</a></div>
</section>
<section class="tools section" id="tools"><h2>Tools we use</h2><div class="tool-grid">{tools.map(([name,key]) => {const icon=key ? icons[key as keyof typeof icons] : null;return <div class="tool">{logoFiles[name] && <span class:list={["tool-logo", { "tool-logo-wide": name === "Unisim" }]} style={`--logo-url: url("${import.meta.env.BASE_URL}logos/${logoFiles[name]}")`} aria-hidden="true"></span>}{icon && typeof icon === 'object' && 'path' in icon && <svg viewBox="0 0 24 24" aria-hidden="true"><path d={icon.path}/></svg>}<span>{name}</span></div>;})}</div></section>
<section class="reasons section"><h2>When to bring us in:</h2><div class="reason-list">{reasons.map((reason,i)=><div class="reason"><span class="number">0{i+1}</span><p>{reason}</p><span class="reason-star" aria-hidden="true">↗</span></div>)}</div></section>
<section class="contact section" id="contact"><div class="contact-heading"><img class="section-mark" src={`${import.meta.env.BASE_URL}logo.svg`} alt="" width="56" height="56"/><h2>We’re made<br/>for <em>you.</em></h2></div><form action={endpoint || undefined} method="POST" data-ready={Boolean(endpoint)}><h3>Contact form</h3><div class="form-row"><label>Your name<input name="name" autocomplete="name" required/></label><label>Work email<input type="email" name="email" autocomplete="email" required/></label></div><label>Company<input name="company" autocomplete="organization" required/></label><label>Topic / what can we help you with?<select name="topic" required><option value="" disabled selected></option><option>Engineering projects</option><option>Design reviews</option><option>Modularity of your designs</option><option>Comprehensive overview of your ideas</option><option>Other</option></select></label><label>Details<textarea name="details" rows="3" required></textarea></label><button type="submit" disabled={!endpoint}>Start a project <span aria-hidden="true">↗</span></button></form></section>
</Layout>
