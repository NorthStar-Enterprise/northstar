---
import '../styles/global.css';
const { title = 'Northstar Evaluation Firm', page = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#0D0221"/><title>{title}</title><link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml"/></head>
<body>
<header class="header"><a class="brand" href={base} aria-label="Northstar Evaluation Firm home"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M24 0 29 19 48 24 29 29 24 48 19 29 0 24 19 19Z" fill="currentColor"/></svg><span>Northstar<span class="brand-sub">Evaluation Firm</span></span></a><nav aria-label="Main navigation"><a href={base} aria-current={page === 'home' ? 'page' : undefined}>Home</a><a href={`${base}about/`} aria-current={page === 'about' ? 'page' : undefined}>About</a><a class="nav-cta" href={`${base}#contact`}>Start a project <span aria-hidden="true">↗</span></a></nav></header>
<main><slot/></main>
<footer><a class="footer-brand" href={base}>Northstar Evaluation Firm</a><a href={`${base}#contact`}>Start a project <span aria-hidden="true">↗</span></a></footer>
</body></html>
