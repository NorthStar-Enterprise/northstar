---
import Layout from '../layouts/Layout.astro';
const people=[{name:'Jerry Fan',discipline:'Physics and Computer Science',education:'UC Berkeley | Stanford University',image:import.meta.env.PUBLIC_JERRY_PHOTO || `${import.meta.env.BASE_URL}team/jerry-fan.jpg`,linkedin:import.meta.env.PUBLIC_JERRY_LINKEDIN || 'https://www.linkedin.com/in/jiale-fan-739593355/'},{name:'Elliot McGuire',discipline:'Materials Science and Engineering',education:'UC Berkeley | UCLA',image:import.meta.env.PUBLIC_ELLIOT_PHOTO || `${import.meta.env.BASE_URL}team/elliot-mcguire.jpg`,linkedin:import.meta.env.PUBLIC_ELLIOT_LINKEDIN || 'https://www.linkedin.com/in/elliot-mcguire-b3411a3a3/'}];
---
<Layout title="About | Northstar Evaluation Firm" page="about"><section class="about section"><h1>About</h1><div class="team-grid">{people.map(person=><article class="person"><div class="portrait">{person.image ? <img src={person.image} alt={person.name} width="800" height="800"/> : <img class="portrait-mark" src={`${import.meta.env.BASE_URL}logo.svg`} alt=""/>}</div><div class="person-heading"><h2>{person.name}</h2>{person.linkedin && <a href={person.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${person.name} LinkedIn profile`}>↗</a>}</div><p>{person.discipline}</p><p class="education">{person.education}</p>{person.linkedin && <a class="text-link" href={person.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>}</article>)}</div></section></Layout>
